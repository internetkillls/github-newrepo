#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const here = dirname(fileURLToPath(import.meta.url));
const pluginRoot = resolve(here, "..");
const vendorCli = resolve(pluginRoot, "runtime", "chatgpt-pro-line", "bin", "chatgpt-pro");
const DEFAULT_ROLES = ["constructor", "independent", "skeptic", "verifier", "merge"];

function arg(name, fallback = "") {
  const prefix = `--${name}=`;
  const hit = process.argv.find((v) => v.startsWith(prefix));
  return hit ? hit.slice(prefix.length) : fallback;
}
function flag(name) { return process.argv.includes(`--${name}`); }
function safe(value, fallback = "default") {
  const out = String(value || fallback).toLowerCase().replace(/[^a-z0-9._-]+/g, "-").replace(/^-+|-+$/g, "");
  return out || fallback;
}
function now() { return new Date().toISOString(); }
function caseId() { return safe(arg("case", process.env.RCC_CASE || "default")); }
function caseDir(id = caseId()) { return resolve(process.cwd(), ".devspace", "rcc", id); }
function statePath(id = caseId()) { return resolve(caseDir(id), "state.json"); }
function ensureCaseDir(id = caseId()) { mkdirSync(caseDir(id), { recursive: true, mode: 0o700 }); return caseDir(id); }
function readState(id = caseId()) {
  const p = statePath(id);
  if (!existsSync(p)) return null;
  return JSON.parse(readFileSync(p, "utf8"));
}
function writeState(state) {
  ensureCaseDir(state.caseId);
  writeFileSync(statePath(state.caseId), `${JSON.stringify(state, null, 2)}\n`, { mode: 0o600 });
}
function roles() {
  const raw = arg("roles", "");
  return (raw ? raw.split(",") : DEFAULT_ROLES).map((x) => safe(x.trim())).filter(Boolean);
}
function aliasFor(id, role) { return safe(`rcc-${id}-${role}`); }

function runVendor(args, { capture = true, env = {} } = {}) {
  if (!existsSync(vendorCli)) throw new Error(`Vendored ChatGPT transport missing: ${vendorCli}`);
  const result = spawnSync(process.execPath, [vendorCli, ...args], {
    cwd: process.cwd(),
    env: {
      ...process.env,
      CHATGPT_REPO_CONTEXT_MODE: process.env.CHATGPT_REPO_CONTEXT_MODE || "off",
      CHATGPT_THREAD_ECHO: process.env.CHATGPT_THREAD_ECHO || "1",
      ...env,
    },
    encoding: "utf8",
    stdio: capture ? ["ignore", "pipe", "pipe"] : "inherit",
  });
  if (!capture) {
    if (result.status !== 0) process.exit(result.status ?? 1);
    return "";
  }
  const stdout = result.stdout || "";
  const stderr = result.stderr || "";
  if (result.status !== 0) {
    const e = new Error(`ChatGPT transport failed (${result.status}): ${stderr || stdout}`);
    e.status = result.status;
    e.stdout = stdout;
    e.stderr = stderr;
    throw e;
  }
  return stdout;
}

function parseJsonOutput(text) {
  const trimmed = String(text || "").trim();
  try { return JSON.parse(trimmed); } catch {}
  const start = trimmed.indexOf("{");
  const end = trimmed.lastIndexOf("}");
  if (start >= 0 && end > start) {
    try { return JSON.parse(trimmed.slice(start, end + 1)); } catch {}
  }
  return null;
}

function workerFromState(state, role) {
  const key = safe(role || "");
  const worker = state?.workers?.find((w) => w.role === key);
  if (!worker) throw new Error(`Worker role not found in case ${state?.caseId || "?"}: ${role}`);
  return worker;
}

function usage() {
  return `Reasoning Consortium Controller browser runtime v0.2\n\n` +
    `Usage:\n` +
    `  rcc-consortium browser warm\n` +
    `  rcc-consortium browser doctor\n` +
    `  rcc-consortium workers spawn --case=<id> [--roles=constructor,independent,skeptic,verifier,merge] [--dry-run]\n` +
    `  rcc-consortium workers list --case=<id>\n` +
    `  rcc-consortium worker send --case=<id> --role=<role> (--prompt=<text>|--prompt-file=<path>)\n` +
    `  rcc-consortium worker read --case=<id> --role=<role>\n` +
    `  rcc-consortium case status --case=<id>\n` +
    `  rcc-consortium selftest\n\n` +
    `v0.2 opens persistent worker tabs but keeps active browser calls C0 serial-safe.\n`;
}

async function main() {
  const group = process.argv[2] || "help";
  const command = process.argv[3] || "";

  if (["help", "--help", "-h"].includes(group)) {
    console.log(usage());
    return;
  }

  if (group === "browser") {
    if (command === "warm") {
      runVendor(["doctor", "--warm"], { capture: false });
      return;
    }
    if (command === "doctor" || command === "live") {
      runVendor(["doctor", "--live"], { capture: false });
      return;
    }
    throw new Error(`Unknown browser command: ${command}`);
  }

  if (group === "workers" && command === "spawn") {
    const id = caseId();
    const rs = roles();
    const dry = flag("dry-run");
    const state = {
      schemaVersion: 1,
      caseId: id,
      createdAt: now(),
      updatedAt: now(),
      runtime: {
        mode: dry ? "DRY-RUN" : "C0_SERIAL_SAFE",
        transport: "vendored-chatgpt-pro-line",
        targetOwnership: "one worker role -> one persistent ChatGPT tab/room",
        parallelGenerationVerified: false,
      },
      workers: [],
    };

    for (const role of rs) {
      const alias = aliasFor(id, role);
      if (dry) {
        state.workers.push({ role, alias, status: "PLANNED", targetId: null, conversationUrl: null });
        continue;
      }
      const stdout = runVendor(["rooms", "new", `--alias=${alias}`]);
      const parsed = parseJsonOutput(stdout);
      if (!parsed?.ok) throw new Error(`Could not create worker room ${alias}: ${stdout}`);
      const target = parsed.result?.target || {};
      const room = parsed.result?.room || {};
      state.workers.push({
        role,
        alias,
        status: "BOUND",
        targetId: target.id || room.targetId || null,
        conversationUrl: target.url || room.activeConversationUrl || room.conversationUrl || null,
        room,
        spawnedAt: now(),
      });
    }
    writeState(state);
    console.log(JSON.stringify({ ok: true, action: "workers.spawn", statePath: statePath(id), state }, null, 2));
    return;
  }

  if (group === "workers" && command === "list") {
    const id = caseId();
    const state = readState(id);
    if (!state) throw new Error(`No RCC case state found: ${statePath(id)}`);
    console.log(JSON.stringify({ ok: true, action: "workers.list", statePath: statePath(id), state }, null, 2));
    return;
  }

  if (group === "worker" && command === "send") {
    const id = caseId();
    const state = readState(id);
    if (!state) throw new Error(`No RCC case state found: ${statePath(id)}`);
    const role = arg("role");
    const worker = workerFromState(state, role);
    const promptFile = arg("prompt-file");
    const prompt = arg("prompt");
    if (!promptFile && !prompt) throw new Error("Provide --prompt=<text> or --prompt-file=<path>.");
    const callArgs = ["call", `--alias=${worker.alias}`, "--no-repo-context"];
    if (promptFile) callArgs.push(`--prompt-file=${resolve(promptFile)}`);
    else callArgs.push(`--prompt=${prompt}`);
    const stdout = runVendor(callArgs);
    const outDir = resolve(caseDir(id), "outputs");
    mkdirSync(outDir, { recursive: true, mode: 0o700 });
    const outPath = resolve(outDir, `${safe(role)}-latest.txt`);
    writeFileSync(outPath, stdout, { mode: 0o600 });
    worker.lastSendAt = now();
    worker.lastOutputPath = outPath;
    state.updatedAt = now();
    writeState(state);
    process.stdout.write(stdout);
    return;
  }

  if (group === "worker" && command === "read") {
    const id = caseId();
    const state = readState(id);
    if (!state) throw new Error(`No RCC case state found: ${statePath(id)}`);
    const role = arg("role");
    const worker = workerFromState(state, role);
    const stdout = runVendor(["read", `--alias=${worker.alias}`]);
    const outDir = resolve(caseDir(id), "outputs");
    mkdirSync(outDir, { recursive: true, mode: 0o700 });
    const outPath = resolve(outDir, `${safe(role)}-read-latest.txt`);
    writeFileSync(outPath, stdout, { mode: 0o600 });
    worker.lastReadAt = now();
    worker.lastReadOutputPath = outPath;
    state.updatedAt = now();
    writeState(state);
    process.stdout.write(stdout);
    return;
  }

  if (group === "case" && command === "status") {
    const id = caseId();
    const state = readState(id);
    if (!state) throw new Error(`No RCC case state found: ${statePath(id)}`);
    let rooms = null;
    try { rooms = parseJsonOutput(runVendor(["rooms", "list"])); } catch (error) { rooms = { ok: false, error: String(error.message || error) }; }
    console.log(JSON.stringify({ ok: true, action: "case.status", statePath: statePath(id), state, transportRooms: rooms }, null, 2));
    return;
  }

  if (group === "selftest") {
    const checks = {
      vendorCliExists: existsSync(vendorCli),
      runtimePackageExists: existsSync(resolve(pluginRoot, "runtime", "chatgpt-pro-line", "package.json")),
      nodeMajorAtLeast20: Number(process.versions.node.split(".")[0]) >= 20,
      dryRunAliases: DEFAULT_ROLES.map((role) => aliasFor("selftest", role)),
    };
    const ok = Object.entries(checks).filter(([k]) => !["dryRunAliases"].includes(k)).every(([, v]) => Boolean(v));
    console.log(JSON.stringify({ ok, action: "selftest", pluginRoot, checks }, null, 2));
    if (!ok) process.exit(1);
    return;
  }

  throw new Error(`Unknown command: ${group} ${command}\n\n${usage()}`);
}

main().catch((error) => {
  console.error(JSON.stringify({ ok: false, error: String(error?.message || error), status: error?.status || null }, null, 2));
  process.exit(error?.status || 1);
});
