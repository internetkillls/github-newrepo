{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AudioMusicPipeline Cross-Modal Contract Schema",
  "description": "DAW-neutral project contract. Note positions and durations use quarter-note beats; one 6/8 bar contains three quarter-note beats.",
  "type": "object",
  "required": ["version", "project_id", "time_transport", "harmonic_system", "tracks", "crossmodal_mappings"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["2.0.0", "2.1.0"]
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "time_transport": {
      "type": "object",
      "required": ["bpm", "meter_numerator", "meter_denominator", "ticks_per_quarter", "total_bars"],
      "properties": {
        "bpm": {
          "type": "number",
          "minimum": 20.0,
          "maximum": 300.0
        },
        "meter_numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "meter_denominator": {
          "type": "integer",
          "enum": [1, 2, 4, 8, 16, 32]
        },
        "ticks_per_quarter": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32767,
          "default": 480
        },
        "total_bars": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "harmonic_system": {
      "type": "object",
      "required": ["scale_root", "scale_mode", "tuning_cents_a4"],
      "properties": {
        "scale_root": {
          "type": "string",
          "enum": ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"]
        },
        "scale_mode": {
          "type": "string",
          "enum": ["major", "natural_minor", "harmonic_minor", "dorian", "phrygian", "lydian", "mixolydian", "locrian", "chromatic", "pentatonic_minor"]
        },
        "tuning_cents_a4": {
          "type": "number",
          "description": "Legacy field name; value is A4 frequency in hertz. MIDI export currently supports 440 Hz only.",
          "minimum": 1.0,
          "default": 440.0
        },
        "chord_progression": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["bar", "degree", "chord_symbol", "bass_note"],
            "properties": {
              "bar": { "type": "integer", "minimum": 1 },
              "degree": { "type": "string" },
              "chord_symbol": { "type": "string" },
              "bass_note": { "type": "string" },
              "voicing_notes": {
                "type": "array",
                "items": { "type": "integer", "minimum": 0, "maximum": 127 }
              }
            }
          }
        }
      }
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["track_id", "name", "role", "midi_channel"],
        "properties": {
          "track_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "role": {
            "type": "string",
            "enum": ["drums", "bass", "harmony_chords", "lead_melody", "fx_texture", "vocal"]
          },
          "midi_channel": { "type": "integer", "minimum": 0, "maximum": 15 },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["start_beat", "duration_beats", "pitch", "velocity"],
              "properties": {
                "start_beat": { "type": "number", "minimum": 0.0, "description": "Zero-based start in quarter-note beats." },
                "duration_beats": { "type": "number", "minimum": 0.001, "description": "Duration in quarter-note beats." },
                "pitch": { "type": "integer", "minimum": 0, "maximum": 127 },
                "velocity": { "type": "integer", "minimum": 1, "maximum": 127 },
                "microtone_cents": { "type": "number", "default": 0.0, "description": "Accepted by the contract; standard MIDI export rejects nonzero values rather than silently discarding them." }
              }
            }
          }
        }
      }
    },
    "crossmodal_mappings": {
      "type": "object",
      "description": "Rules for converting between audio/music and visual control/scores.",
      "required": ["audio_to_visual", "visual_to_audio"],
      "properties": {
        "audio_to_visual": {
          "type": "object",
          "required": ["stems_to_cube_ribbons", "spectral_bands"],
          "properties": {
            "stems_to_cube_ribbons": {
              "type": "object",
              "properties": {
                "drums_target": { "type": "string", "default": "amplitude" },
                "bass_target": { "type": "string", "default": "stroke_width" },
                "lead_target": { "type": "string", "default": "spatial_harmonic" },
                "fx_target": { "type": "string", "default": "band_span" },
                "safe_margin_constant": { "type": "number", "minimum": 0.0, "maximum": 0.5, "default": 0.42 }
              }
            },
            "spectral_bands": {
              "type": "object",
              "properties": {
                "sub": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
                "bass": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
                "mid": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
                "high": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
              }
            }
          }
        },
        "visual_to_audio": {
          "type": "object",
          "required": ["coordinate_space", "y_to_pitch_mapping", "x_to_time_mapping", "density_to_velocity"],
          "properties": {
            "coordinate_space": {
              "type": "object",
              "properties": {
                "x_range": { "type": "array", "items": { "type": "number" }, "default": [0.0, 1.0] },
                "y_range": { "type": "array", "items": { "type": "number" }, "default": [0.0, 1.0] }
              }
            },
            "y_to_pitch_mapping": {
              "type": "object",
              "properties": {
                "min_midi_note": { "type": "integer", "default": 36 },
                "max_midi_note": { "type": "integer", "default": 84 },
                "quantize_to_scale": { "type": "boolean", "default": true }
              }
            },
            "x_to_time_mapping": {
              "type": "object",
              "properties": {
                "total_duration_beats": { "type": "number", "default": 16.0 },
                "quantize_subdivision": { "type": "number", "default": 0.25 }
              }
            },
            "density_to_velocity": {
              "type": "object",
              "properties": {
                "min_velocity": { "type": "integer", "default": 40 },
                "max_velocity": { "type": "integer", "default": 120 }
              }
            }
          }
        }
      }
    }
  }
}
